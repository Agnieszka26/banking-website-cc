generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth (core + `username` plugin). These tables are created by Prisma.
// ---------------------------------------------------------------------------

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  username        String?   @unique
  displayUsername String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  accounts        Account[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Plaid integration (active). Tokens in `plaid_link`; accounts/transactions
// synced to cache tables via `sync.service.ts` (sync-on-link + stale refresh).
// Dashboard reads DB cache first; live Plaid API is fallback during sync.
// ---------------------------------------------------------------------------

model PlaidLink {
  userId               String    @id @map("user_id")
  accessToken          String    @map("access_token")
  itemId               String?   @map("item_id")
  accountsSyncedAt     DateTime? @map("accounts_synced_at") @db.Timestamptz(6)
  transactionsSyncedAt DateTime? @map("transactions_synced_at") @db.Timestamptz(6)
  syncError            String?   @map("sync_error")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  cachedAccounts       PlaidCachedAccount[]
  cachedTransactions   PlaidCachedTransaction[]

  @@map("plaid_link")
}

model PlaidCachedAccount {
  plaidAccountId String   @id @map("plaid_account_id")
  userId         String   @map("user_id")
  name           String
  mask           String?
  balance        Decimal  @db.Decimal(14, 2)
  currency       String   @default("PLN")
  type           String
  syncedAt       DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  link           PlaidLink @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("plaid_cached_accounts")
}

model PlaidCachedTransaction {
  plaidTransactionId String   @id @map("plaid_transaction_id")
  userId             String   @map("user_id")
  plaidAccountId     String   @map("plaid_account_id")
  date               String
  name               String
  amount             Decimal  @db.Decimal(14, 2)
  currency           String   @default("PLN")
  syncedAt           DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  link               PlaidLink @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date(sort: Desc)])
  @@map("plaid_cached_transactions")
}

// ---------------------------------------------------------------------------
// Legacy Supabase tables (deprecated — not used by application code).
// Introspected from an earlier schema. Kept in Prisma so `db push` does not
// drop existing tables or RLS policies. Do not query from app code; use Plaid
// types in `src/server/plaid/types.ts` and `plaidLinkRepository` instead.
// Removal tracked when a Plaid sync/cache model replaces these tables.
// ---------------------------------------------------------------------------

model LegacyProfile {
  id        BigInt            @id @default(autoincrement())
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  firstName String?           @map("first_name")
  lastName  String?           @map("last_name")
  phone     String?
  userUid   String?           @unique @map("user_UID")
  email     String?
  accounts  LegacyBankAccount? @relation(fields: [userUid], references: [userUid], onDelete: NoAction, onUpdate: NoAction)

  @@map("profiles")
}

model LegacyBankAccount {
  id            BigInt             @id @default(autoincrement())
  userUid       String?            @unique @map("user_UID")
  accountNumber Decimal?           @map("account_number") @db.Decimal
  balance       Decimal?           @db.Decimal
  accountId     String?            @unique @map("account_id")
  transactions  LegacyTransaction? @relation(fields: [accountId], references: [accountId], onDelete: NoAction, onUpdate: NoAction)
  profiles      LegacyProfile?

  @@map("accounts")
}

model LegacyTransaction {
  id        BigInt             @id @default(autoincrement())
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  accountId String?            @unique @map("account_id")
  amount    Decimal?           @db.Decimal(14, 2)
  type      String?
  accounts  LegacyBankAccount?

  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Application ledger (system of record). Separate from legacy `accounts` /
// `transactions` and from Plaid cache tables. See docs/API_CONTRACTS.md and
// docs/transactions-server-boundary.md.
// ---------------------------------------------------------------------------

model LedgerAccount {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String              @map("user_id")
  name         String
  currency     String              @db.Char(3)
  balanceMinor Int                 @map("balance_minor")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  transactions LedgerTransaction[]

  @@index([userId])
  @@map("ledger_accounts")
}

model LedgerTransfer {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id")
  sourceAccountId      String   @map("source_account_id") @db.Uuid
  destinationAccountId String   @map("destination_account_id") @db.Uuid
  amountMinor          Int      @map("amount_minor")
  currency             String   @db.Char(3)
  title                String
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, sourceAccountId, destinationAccountId, amountMinor, currency, title, createdAt])
  @@map("ledger_transfers")
}

model LedgerTransaction {
  id                        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId                 String        @map("account_id") @db.Uuid
  amountMinor               Int           @map("amount_minor")
  currency                  String        @db.Char(3)
  direction                 String
  type                      String
  title                     String
  counterpartyName          String?       @map("counterparty_name")
  counterpartyAccountNumber String?       @map("counterparty_account_number")
  transferId                String?       @map("transfer_id") @db.Uuid
  bookingDate               DateTime      @map("booking_date") @db.Date
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  account                   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, bookingDate(sort: Desc), createdAt(sort: Desc)])
  @@index([transferId])
  @@map("ledger_transactions")
}

// ---------------------------------------------------------------------------
// CMS content (active reads via Supabase client, not Prisma repositories).
// ---------------------------------------------------------------------------

model news {
  id           BigInt    @id @default(autoincrement())
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  title        String?
  subtitle     String?
  published_at DateTime? @default(now()) @db.Timestamp(6)
  category     String?
  body         String?
  slug         String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
}
